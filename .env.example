# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Local Postgres. Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://neuro:neuro@localhost:5432/neuroscience?schema=public"

# next-auth — generate with: openssl rand -base64 32
AUTH_SECRET=""

# reCAPTCHA v3 keys (Google's public test keys shown; replace for production)
RECAPTCHA_SITE_KEY="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"
RECAPTCHA_SECRET_KEY="6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe"

# Authorized-login allowlist — ONLY these emails can ever log in (comma-separated).
# No public sign-up exists; this is the gate enforced at authentication time.
ALLOWED_EMAILS="admin@example.com"

# Admin account created by `npm run seed`. ADMIN_EMAIL must be in ALLOWED_EMAILS.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"
